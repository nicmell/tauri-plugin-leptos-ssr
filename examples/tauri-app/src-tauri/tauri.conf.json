{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.example.tauri-leptos-ssr",
  "build": {
    "beforeDevCommand": {
      "script": "if [ \"$TAURI_ENV_PLATFORM\" = android ]; then adb reverse tcp:3001 tcp:3001; fi; cargo leptos watch",
      "cwd": "..",
      "wait": false
    },
    "beforeBuildCommand": {
      "script": "cargo leptos build --release --frontend-only",
      "cwd": ".."
    },
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../target/site"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
